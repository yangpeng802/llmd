# SpeakBuddy configuration (all optional).
# Copy this file to `.env` and adjust, or export the variables directly.

# Ollama's OpenAI-compatible endpoint
OLLAMA_HOST=http://localhost:11434/v1

# Local open-weights model to chat with.
# Default is gemma3:1b (fast, tiny). For noticeably better English,
# use the 4B model instead: OLLAMA_MODEL=gemma3  (and run `ollama pull gemma3`)
OLLAMA_MODEL=gemma3:1b
